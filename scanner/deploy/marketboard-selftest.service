# P0 acceptance check. Runs under the same user, env file and sandbox as the scanner:
#   sudo systemctl start marketboard-selftest && journalctl -u marketboard-selftest -n 20 --no-pager
[Unit]
Description=MarketBoard P0 self-test (Alpaca clock, ingest ping, Telegram test message)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=marketboard
Group=marketboard
WorkingDirectory=/opt/marketboard/scanner
EnvironmentFile=/etc/marketboard/env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/marketboard/.venv/bin/python -m marketboard.main --selftest

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/marketboard
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
